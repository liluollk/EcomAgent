# 数据库连接串（SQLAlchemy asyncpg 方言）
RUNTIME_DATABASE_URL=postgresql+asyncpg://runtime:runtime@localhost:5432/agent_runtime

# 持久化测试库连接串（pytest fixture 会按需创建该数据库并应用迁移）
RUNTIME_TEST_DATABASE_URL=postgresql+asyncpg://runtime:runtime@localhost:5432/agent_runtime_test

# 迁移环境读取顺序：migrations/env.py 优先 RUNTIME_DATABASE_URL，测试注入 RUNTIME_TEST_DATABASE_URL


# 主密钥：32 字节密钥的 Base64 编码字符串（用于 AES-GCM Secret 加密）。
# 此处留空占位；请勿将真实 Key 提交到版本库。
RUNTIME_MASTER_KEY=
